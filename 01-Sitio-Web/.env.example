# ============================================================
# Girlys · configuración de la web
#
# Copia este archivo como .env (sin el .example) y completa lo que
# haga falta. Lo que dejes vacío simplemente no se muestra: no hay
# enlaces rotos ni scripts de terceros cargando de más.
#
# Después de cambiar algo aquí, hay que volver a construir:
#   npm run build
# ============================================================

# Dirección pública del sitio (sin barra final)
VITE_SITE_ORIGIN=https://TU-DOMINIO.com

# WhatsApp en formato internacional, solo números. Bolivia = 591.
# Es el número del botón flotante y del mensaje de la calculadora.
VITE_WHATSAPP_PHONE=59160475900

# Google Analytics 4. Ejemplo: G-XXXXXXXXXX
# Si queda vacío, no se carga Google Analytics ni aparece el aviso.
VITE_GA_MEASUREMENT_ID=

# Tawk.to (chat en línea). Pega "propertyId/widgetId" tal como aparece
# en el snippet de Tawk, o la URL completa del embed.
# Si queda vacío, no se carga ningún chat.
VITE_TAWK_PROPERTY_ID=

# Redes sociales. Pega la URL pública del perfil. Las que queden
# vacías no aparecen en el pie.
VITE_INSTAGRAM_URL=
VITE_TIKTOK_URL=
VITE_FACEBOOK_URL=
VITE_YOUTUBE_URL=
VITE_TELEGRAM_URL=
VITE_MESSENGER_URL=

# Correo de contacto (opcional; hoy el sitio usa WhatsApp)
VITE_CONTACT_EMAIL=

# El blog es estático y vive en /blog dentro del mismo sitio.
# No hay URL que configurar ni servidor PHP que mantener.
