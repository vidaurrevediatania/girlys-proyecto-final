# ============================================================
# Girlys · Apache (CWP)
# Sitio estático: React compilado en dist/.
# Este archivo se copia a public_html/.htaccess en cada publicación.
# ============================================================

Options -MultiViews -Indexes
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. www -> sin www (el dominio canónico es sin www)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # 2. Todo por HTTPS. Se mira también X-Forwarded-Proto por si el
  #    hosting termina el TLS antes de Apache.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # 3. Si más adelante se instala WordPress en /blog, que él mande ahí.
  RewriteRule ^blog(/|$) - [L]

  # 4. Archivos y carpetas que existen: se sirven tal cual.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 5. Un archivo inexistente con extensión da 404 de verdad,
  #    no la portada disfrazada de 200.
  RewriteCond %{REQUEST_URI} \.[a-z0-9]{2,5}$ [NC]
  RewriteRule ^ - [R=404,L]

  # 6. Lo demás es la aplicación (una sola página).
  RewriteRule ^ index.html [L]
</IfModule>

# ------------------------------------------------------------
# Compresión
# ------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml font/woff2
</IfModule>

# ------------------------------------------------------------
# Caché
# ------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  # el HTML cambia en cada publicación: que el navegador pregunte
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # los archivos del build llevan hash en el nombre: se pueden cachear fuerte
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # HSTS: activar SOLO cuando el candado funcione en todo el dominio
  # y estén resueltos http y www. Si se activa antes, se puede dejar
  # el sitio inaccesible. Se deja comentado a propósito.
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ------------------------------------------------------------
# Archivos ocultos (menos .well-known, que usa el SSL)
# ------------------------------------------------------------
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# ------------------------------------------------------------
# Tipos MIME que alguns servidores viejos no reconocen
# ------------------------------------------------------------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
</IfModule>
